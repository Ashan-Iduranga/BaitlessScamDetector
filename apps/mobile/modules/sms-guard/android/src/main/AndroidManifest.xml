<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- SMS Guard: see incoming SMS as they arrive (not the inbox) and warn about risky ones. -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!-- BROADCAST_SMS: only the system can send this broadcast, so other apps cannot fake an SMS. -->
    <receiver
      android:name=".SmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
    <service android:name=".SmsGuardTaskService" android:exported="false" />
  </application>
</manifest>
